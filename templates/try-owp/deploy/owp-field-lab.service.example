[Unit]
Description=Open Work Protocol Field Lab
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=owp-field-lab
Group=owp-field-lab
WorkingDirectory=/opt/owp-field-lab
EnvironmentFile=/etc/owp-field-lab.env
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/usr/bin/python3 -m owp_field_lab.server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/owp-field-lab
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
