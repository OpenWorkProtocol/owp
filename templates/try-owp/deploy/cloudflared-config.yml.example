# Locally-managed Cloudflare Tunnel example.
# Prefer a remotely-managed tunnel for most production deployments.
# Never commit the real credentials JSON.
tunnel: <TUNNEL_UUID>
credentials-file: /etc/cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: __OWP_PUBLIC_HOSTNAME__
    service: http://127.0.0.1:8080
  - service: http_status:404
