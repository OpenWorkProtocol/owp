OWP_FIELD_LAB_HOST=127.0.0.1
OWP_FIELD_LAB_PORT=8080
OWP_FIELD_LAB_DB=/var/lib/owp-field-lab/owp-field-lab.sqlite3
OWP_FIELD_LAB_QUEUE_MAX=20
OWP_FIELD_LAB_SUBMISSIONS_PER_HOUR=5
OWP_FIELD_LAB_SSE_MAX_CLIENTS=32
OWP_FIELD_LAB_SSE_INTERVAL=10
OWP_FIELD_LAB_TRUST_PROXY=1
GITHUB_TOKEN=replace-with-a-read-token

OWP_FIELD_LAB_PROVIDER_ID=__OWP_PROVIDER_ACTOR__
