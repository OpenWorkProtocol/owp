{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openworkprotocol.org/schema/software-work-validator-attestation/v1",
  "title": "OWP Software Work Validator Attestation v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "digest"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "digest": {
            "type": "object",
            "required": [
              "gitCommit",
              "gitTree"
            ],
            "properties": {
              "gitCommit": {
                "type": "string",
                "minLength": 40,
                "maxLength": 64
              },
              "gitTree": {
                "type": "string",
                "minLength": 40,
                "maxLength": 64
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "predicateType": {
      "const": "https://openworkprotocol.org/attestation/software-work-validation/v1"
    },
    "predicate": {
      "type": "object",
      "required": [
        "work_ref",
        "attempt_id",
        "contract_digest",
        "execution_commitment_digest",
        "expected_source",
        "observed_result",
        "delivery_claim_digest",
        "validator",
        "policy_version",
        "acceptance_results",
        "outcome"
      ],
      "properties": {
        "work_ref": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "execution_commitment_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "delivery_claim_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "expected_source": {
          "type": "object"
        },
        "observed_result": {
          "type": "object"
        },
        "validator": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "acceptance_results": {
          "type": "array"
        },
        "outcome": {
          "enum": [
            "VALID",
            "INVALID",
            "INDETERMINATE"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
